CM_ SG_ 1360 AccessOpen "Control-access window is open";
CM_ SG_ 1360 AckFlagsReserved "Reserved acknowledgement flag bits; transmit zero";
CM_ SG_ 1360 AccessWindowRemaining "Ceiling of remaining control-access time";
CM_ SG_ 1360 Reserved "Reserved; transmit zero";
CM_ BO_ 1362 "TIC12400 device and service status";
CM_ SG_ 1362 Online "TIC12400 communication is online";
CM_ SG_ 1362 ConfigurationValid "Startup register configuration passed readback";
CM_ SG_ 1362 CrcComplete "TIC12400 configuration CRC completed";
CM_ SG_ 1362 Monitoring "Switch monitoring is active";
CM_ SG_ 1362 StatusReserved4 "Reserved status bit; transmit zero";
CM_ SG_ 1362 PorObserved "Power-on-reset indication was observed";
CM_ SG_ 1362 ServiceFault "Latest TIC12400 service operation failed";
CM_ SG_ 1362 StatusReserved7 "Reserved status bit; transmit zero";
CM_ SG_ 1362 DeviceId "TIC12400 device identifier register value";
CM_ SG_ 1362 ServiceResult "Latest TIC12400 service result";
CM_ SG_ 1362 SpiFail "Device reported an SPI error";
CM_ SG_ 1362 ParityFail "Device reported a parity error";
CM_ SG_ 1362 SwitchStateChange "Switch-state-change interrupt was observed";
CM_ SG_ 1362 SupplyThreshold "Supply-threshold interrupt was observed";
CM_ SG_ 1362 Temperature "Temperature interrupt was observed";
CM_ SG_ 1362 OtherInterrupt "Other device interrupt was observed";
CM_ SG_ 1362 PowerOnReset "Transaction reported power-on reset";
CM_ SG_ 1362 TransactionReserved "Reserved transaction bit; transmit zero";
CM_ SG_ 1362 ServiceFailureCount "Saturating TIC12400 service failure count";
CM_ SG_ 1362 LastInterruptStatus "Last nonzero TIC12400 interrupt status";
CM_ BO_ 1364 "Debounced TIC12400 open/closed switch state";

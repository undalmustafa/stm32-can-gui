CM_ SG_ 1364 ValidBitmap "One bit per channel; one denotes valid switch data";
CM_ SG_ 1364 Generation "Switch-state generation counter";
CM_ SG_ 1364 DataValid "The switch-state frame is valid";
CM_ SG_ 1364 Reserved "Reserved; transmit zero";
CM_ BO_ 1365 "Applied TIC12400 switch-polarity profile";
CM_ SG_ 1365 BatterySwitchBitmap "One bit per channel; one selects battery switching";
CM_ SG_ 1365 BatteryCapableBitmap "One bit per channel; one denotes battery capability";
CM_ SG_ 1365 Generation "Applied profile generation counter";
